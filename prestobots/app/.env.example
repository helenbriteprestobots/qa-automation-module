# Copy this file to `.env` (same folder) and fill it in. `.env` is never committed.

# ── Which chatbot the platform talks to ──────────────────────────────────────
# demo  → a simulated bot built into the platform. Needs nothing else. Good for trying the platform.
# stage → the real Cauce chatbot on salud-stage. Needs every value in the "stage" block below.
CHATBOT_MODE=demo

# Port of the platform (open http://localhost:4000 after `pnpm start`)
PORT=4000

# ── stage mode only ──────────────────────────────────────────────────────────
# Firebase project. The platform refuses to run against anything that is not on the allow-list (salud-stage).
STAGE_PROJECT_ID=salud-stage

# Reading the bot's replies: sign in with your prestobots.com Google account in the platform's Settings
# page (read-only access to salud-stage). No key file is needed; STAGE_SERVICE_ACCOUNT_FILE is no longer used.

# The QA clinic (organization id in salud-stage). The existing one is testing-macena-gupshup-v3-qa.
STAGE_QA_ORG_ID=testing-macena-gupshup-v3-qa

# URL of the chatbot's Gupshup webhook on salud-stage. Confirm the exact URL with the developers.
STAGE_WEBHOOK_URL=https://us-central1-salud-stage.cloudfunctions.net/webhookGupshupMessages

# The test patient: the phone number the fake messages come "from" (country code, no +, no spaces).
# The bot's replies are delivered to this WhatsApp number.
TEST_PATIENT_PHONE=
TEST_PATIENT_NAME=QA Paciente

# Message sent before every test so the bot starts from scratch. "hola" is the bot's starting message.
# Leave empty to skip it.
TEST_RESET_MESSAGE=hola

# How long to wait for the bot to answer each message, in seconds.
REPLY_TIMEOUT_SECONDS=45

# Local copy of the chatbot code. Only used by "Generate test cases" in stage mode, to read the
# WhatsApp booking form. Optional: if the folder isn't there, it is simply skipped.
CHATBOT_REPO_DIR=../repos/prestobotsv3-main

# Google sign-in client. Leave empty to use the public client of firebase-tools (the same one
# `firebase login` uses). Set both only if you created your own "Desktop app" OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── AI (Claude) ──────────────────────────────────────────────────────────────
# Claude API key used ONLY by this platform (create one in the Claude Console). Leave empty to keep AI off:
# tests still run with their rule checks, and AI-judge checks are skipped.
ANTHROPIC_API_KEY=

# Model that writes test cases, explains failures and summarises runs.
AI_MODEL_AUTHOR=claude-opus-5-5
# Model for the AI judge (runs on many steps, so a cheaper one).
AI_MODEL_JUDGE=claude-haiku-5-5

# Starting monthly budget in US$. You can change it later in the platform's Settings page.
AI_MONTHLY_BUDGET_USD=20

# ── Jira ─────────────────────────────────────────────────────────────────────
# Lets admins create a Jira card from a failed test. Leave empty to keep Jira off.
# Your Jira address, e.g. yourcompany.atlassian.net
JIRA_SITE=
# Email of the Jira account that creates the cards, and an API token for that account
# (create it at https://id.atlassian.com/manage-profile/security/api-tokens).
JIRA_EMAIL=
JIRA_API_TOKEN=
# Project where cards go: the letters before the card numbers, e.g. CHAT for CHAT-123.
JIRA_PROJECT_KEY=
# Labels added to every card, comma separated (the test case id is always added too).
JIRA_LABELS=chatbot-qa
# Priority name as it appears in Jira (e.g. Medium). Leave empty to use Jira's default.
JIRA_PRIORITY=
