#!/bin/sh
# Validates pushed branch names and blocks direct pushes to protected branches,
# per prestobots/docs/git-standards.md (generated by git-skill-creator).
# Keep these values in sync with the "Branch naming" and "Merging and history" sections.
BRANCH_REGEX='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)/[a-z0-9]+(-[a-z0-9]+)*$'
MAX_BRANCH_LENGTH='50'      # empty = no limit
BASE_BRANCHES='main'        # space-separated; always valid names
PROTECTED_BRANCHES='main'   # space-separated; direct pushes blocked (empty = allowed)

zero='0000000000000000000000000000000000000000'
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/*) branch=${remote_ref#refs/heads/} ;;
    *) continue ;; # tags and other refs are not checked
  esac
  # Deleting a remote branch is not validated.
  [ "$local_sha" = "$zero" ] && continue

  for protected in $PROTECTED_BRANCHES; do
    if [ "$branch" = "$protected" ]; then
      echo "✖ Direct pushes to '$branch' are not allowed (prestobots/docs/git-standards.md). Open a pull request instead." >&2
      status=1
      continue 2
    fi
  done

  for base in $BASE_BRANCHES; do
    [ "$branch" = "$base" ] && continue 2
  done

  if [ -n "$MAX_BRANCH_LENGTH" ] && [ "${#branch}" -gt "$MAX_BRANCH_LENGTH" ]; then
    echo "✖ Branch name '$branch' is ${#branch} characters; the maximum is $MAX_BRANCH_LENGTH (prestobots/docs/git-standards.md)." >&2
    status=1
    continue
  fi

  if ! printf '%s\n' "$branch" | grep -Eq "$BRANCH_REGEX"; then
    echo "✖ Branch name '$branch' does not follow prestobots/docs/git-standards.md." >&2
    echo "  Expected to match: $BRANCH_REGEX (or use /git-branch)." >&2
    status=1
  fi
done

exit $status
