#!/bin/sh
# Validates the commit message against prestobots/docs/git-standards.md (generated by git-skill-creator).
# Keep COMMIT_HEADER_REGEX in sync with the "Commits" section of the standards.
COMMIT_HEADER_REGEX='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)!?: [^ ](.*[^.])?$'
MAX_HEADER_LENGTH='72' # empty = no limit
# AI attribution is forbidden ("Commits" section): trailers or lines naming an AI tool.
AI_ATTRIBUTION_REGEX='^(co-authored-by:.*(claude|anthropic|copilot|openai|chatgpt|gpt-|gemini|cursor)|.*generated with .*(claude|copilot|chatgpt|cursor|gemini))'

msg_file="$1"
header=$(grep -v '^#' "$msg_file" | sed -n '/[^[:space:]]/{p;q;}')

# Messages generated by git itself are always allowed.
case "$header" in
  "Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

if grep -v '^#' "$msg_file" | grep -Eiq "$AI_ATTRIBUTION_REGEX"; then
  echo "✖ AI attribution lines are not allowed in commits (prestobots/docs/git-standards.md):" >&2
  grep -v '^#' "$msg_file" | grep -Ei "$AI_ATTRIBUTION_REGEX" | sed 's/^/    /' >&2
  echo "  Remove them and commit again." >&2
  exit 1
fi

if [ -n "$MAX_HEADER_LENGTH" ] && [ "${#header}" -gt "$MAX_HEADER_LENGTH" ]; then
  echo "✖ Commit header is ${#header} characters; the maximum is $MAX_HEADER_LENGTH (prestobots/docs/git-standards.md)." >&2
  exit 1
fi

if printf '%s\n' "$header" | grep -Eq "$COMMIT_HEADER_REGEX"; then
  exit 0
fi

echo "✖ Commit message header does not follow prestobots/docs/git-standards.md:" >&2
echo "    $header" >&2
echo "  Expected to match: $COMMIT_HEADER_REGEX" >&2
echo "  See the Quick reference in prestobots/docs/git-standards.md (or use /git-commit)." >&2
exit 1
